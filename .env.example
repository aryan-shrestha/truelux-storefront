# Every variable here is required and has no default. A missing one fails the
# build rather than rendering a page that half works. Read in lib/env.ts only.

# Used by Server Components for catalogue reads; never exposed to the browser.
# On Vercel it must be the API's public HTTPS origin: functions run outside your
# network. A private address only works when self-hosting beside the API.
API_BASE_URL=http://localhost:8000

# Used by the browser for checkout and the order routes. PUBLIC — compiled into
# the client bundle. The backend's DJANGO_CORS_ALLOWED_ORIGINS must include this
# storefront's own origin for these calls to work.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# This storefront's origin. Canonical URLs, sitemap and Open Graph resolve
# against it; without it, production Open Graph images resolve to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The wordmark and every page title. Configuration rather than a constant, per
# ADR 0007 — the design must tolerate a name of any plausible length.
NEXT_PUBLIC_BRAND_NAME=Threadline

# Display copy on the checkout page. NOT authoritative: the shipping fee is
# computed by the backend and returned with the placed order. This string
# duplicates the backend's SHIPPING_FEE_* settings in prose and must be updated
# by hand when they change.
NEXT_PUBLIC_SHIPPING_NOTE=Rs 150 inside the Kathmandu valley, Rs 250 elsewhere.
